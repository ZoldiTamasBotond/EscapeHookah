{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "reservations": {
      ".read": "auth != null",
      "$reservationId": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('Role').val() === 'Admin' || (!data.exists() && newData.child('UserId').val() === auth.uid) || (data.exists() && data.child('UserId').val() === auth.uid && newData.child('UserId').val() === auth.uid))",

        "UserId": { ".validate": "newData.isString() && (newData.val() === auth.uid || root.child('users').child(auth.uid).child('Role').val() === 'Admin')" },
        "UserName": { ".validate": "!newData.exists() || newData.isString()" },
        "TableNumber": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "ReservationDate": { ".validate": "newData.exists() && (newData.isString() || newData.isNumber())" },
        "StartTime": { ".validate": "newData.exists() && (newData.isString() || newData.isNumber())" },
        "EndTime": { ".validate": "newData.exists() && (newData.isString() || newData.isNumber())" },
        "NumberOfGuests": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 8" },
        "SpecialRequests": { ".validate": "!newData.exists() || newData.isString()" },
        "MenuItems": {
          "$itemId": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        },
        "HookahMixes": {
          "$mixId": {
            "PricingMenuItemId": { ".validate": "newData.isString()" },
            "MixType": { ".validate": "newData.isString() || newData.isNumber()" },
            "DisplayName": { ".validate": "newData.isString()" },
            "FlavorPercentages": {
              "$flavorId": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" }
            }
          }
        },
        "Status": { ".validate": "(newData.isNumber() && (newData.val() == 0 || newData.val() == 1 || newData.val() == 2)) || (newData.isString() && (newData.val() === 'Pending' || newData.val() === 'Confirmed' || newData.val() === 'Cancelled'))" },
        "CreatedAt": { ".validate": "newData.exists() && (newData.isNumber() || newData.isString())" },
        "ExpiresAt": { ".validate": "!newData.exists() || newData.isNumber() || newData.isString()" }
      }
    },

    "menu": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('Role').val() === 'Admin'"
    },

    "usernames": {
      ".read": true,
      ".write": "auth != null",
      "$username": { ".validate": "!data.exists() || data.val() === auth.uid" }
    },

    "deviceTokens": {
      "$uid": {
        "$token": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString()"
        }
      }
    },

    ".read": false,
    ".write": false
  }
}
