@page "/reservations"
@using EscapeHookah.Shared.Services
@using EscapeHookah.Shared.Models
@using System.Timers
@using System.Diagnostics
@inject IFirebaseAuthService FirebaseAuthService
@inject IReservationService ReservationService
@inject IMenuService MenuService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>EscapeHookah - Reservations</PageTitle>

<!-- Authentication Check -->
@if (!FirebaseAuthService.IsAuthenticated)
{
    <div class="auth-required">
        <div class="auth-card">
            <div class="auth-icon">🔒</div>
            <h2>Login Required</h2>
            <p>Please log in to make a reservation</p>
            <button class="cta-button" @onclick="GoToLogin">
                Go to Login
            </button>
        </div>
    </div>
}
else
{
    <!-- Main Content -->
    <div class="reservations-container">
        <!-- Header -->
        <div class="reservations-header">
            <h1>Make a Reservation</h1>
            <p>Welcome back, @userName!</p>
        </div>

        <!-- Loading Indicator -->
        @if (isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner"></div>
                <p>Processing your reservation...</p>
            </div>
        }

        <!-- Error Message -->
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="error-message">
                ⚠️ @errorMessage
            </div>
        }

        <!-- Success Message -->
        @if (showSuccess)
        {
            <div class="success-message">
                ✅ Reservation confirmed! Check your reservations below.
            </div>
        }

        <!-- Reservation Form -->
        <div class="reservation-form">
            <h2>Select Table and Time</h2>

            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Select Date</label>
                    <input type="date"
                           class="form-input"
                           @bind="selectedDate"
                           @bind:format="yyyy-MM-dd"
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                </div>

                <div class="form-group">
                    <label class="form-label">Number of Guests</label>
                    <input type="number"
                           class="form-input"
                           @bind="numberOfGuests"
                           min="1" max="8" />
                </div>
            </div>

            <!-- Tables Grid -->
            <h3>Available Tables for @selectedDate.ToString("MMMM dd, yyyy")</h3>
            <div class="tables-grid">
                @foreach (var table in tables)
                {
                    var isAvailable = IsTableAvailable(table);
                    <div class="table-card @(selectedTable == table.TableNumber ? "selected" : "") @(isAvailable ? "available" : "unavailable")"
                         @onclick="() => SelectTable(table.TableNumber)">
                        <div class="table-number">Table @table.TableNumber</div>
                        <div class="table-info">
                            <div>👥 Capacity: @table.Capacity</div>
                            <div>📍 @table.Location</div>
                            <div class="table-status">
                                @if (isAvailable)
                                {
                                    <span class="status-badge available">Available</span>
                                }
                                else
                                {
                                    <span class="status-badge unavailable">Booked</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Time Selection -->
            @if (selectedTable > 0)
            {
                <div class="time-selection">
                    <h3>Select Time for Table @selectedTable</h3>
                    <div class="time-slots">
                        @foreach (var slot in timeSlots)
                        {
                            <button class="time-slot @(selectedStartTime == slot.Start ? "selected" : "")"
                                    @onclick="() => SelectTimeSlot(slot.Start, slot.End)">
                                @slot.Display
                            </button>
                        }
                    </div>
                    @if (selectedStartTime != TimeSpan.Zero)
                    {
                        <div class="selected-time-info">
                            Selected: @selectedStartTime.ToString(@"hh\:mm") - @selectedEndTime.ToString(@"hh\:mm")
                        </div>
                    }
                </div>
            }

            <!-- Special Requests -->
            @if (selectedTable > 0 && selectedStartTime != TimeSpan.Zero)
            {
                <div class="form-group">
                    <label class="form-label">Special Requests (Optional)</label>
                    <textarea class="form-input"
                              @bind="specialRequests"
                              rows="3"
                              placeholder="Any special requests? (e.g., allergies, occasion, etc.)"></textarea>
                </div>
                <div class="reservation-summary">
                    <h3>Reservation Summary</h3>
                    <div class="summary-details">
                        <p><strong>Table:</strong> @selectedTable</p>
                        <p><strong>Date:</strong> @selectedDate.ToString("MMMM dd, yyyy")</p>
                        <p><strong>Time:</strong> @selectedStartTime.ToString(@"hh\:mm") - @selectedEndTime.ToString(@"hh\:mm")</p>
                        <p><strong>Guests:</strong> @numberOfGuests</p>
                        @if (!string.IsNullOrEmpty(specialRequests))
                        {
                            <p><strong>Special Requests:</strong> @specialRequests</p>
                        }
                    </div>
                    <button class="confirm-button" @onclick="ConfirmReservation">
                        Confirm Reservation
                    </button>
                </div>
            }
        </div>

        <!-- My Reservations -->
        <div class="my-reservations">
            <h2>My Reservations</h2>
            @if (userReservations.Count == 0)
            {
                <p class="no-reservations">You don't have any reservations yet.</p>
            }
            else
            {
                <div class="reservations-list">
                    @foreach (var reservation in userReservations)
                    {
                        <div class="reservation-item @reservation.Status.ToString().ToLower()">
                            <div class="reservation-header">
                                <span class="reservation-table">Table @reservation.TableNumber</span>
                                <span class="reservation-status @reservation.Status.ToString().ToLower()">
                                    @reservation.Status
                                </span>
                            </div>
                            <div class="reservation-details">
                                <p>📅 @reservation.ReservationDate.ToString("MMMM dd, yyyy")</p>
                                <p>⏰ @reservation.StartTime.ToString(@"hh\:mm") - @reservation.EndTime.ToString(@"hh\:mm")</p>
                                <p>👥 @reservation.NumberOfGuests guests</p>
                                @if (!string.IsNullOrEmpty(reservation.SpecialRequests))
                                {
                                    <p class="special-requests">📝 @reservation.SpecialRequests</p>
                                }

                                @if (reservation.MenuItems != null && reservation.MenuItems.Count > 0)
                                {
                                    <div class="reservation-menu">
                                        <h4>Menu items</h4>
                                        <ul>
                                            @foreach (var mi in reservation.MenuItems)
                                            {
                                                var menuItemId = mi.Key;
                                                var qty = mi.Value;
                                                var menuPrice = (menuItemsDict != null && menuItemsDict.TryGetValue(menuItemId, out var m) ? m.Price : 0m);
                                                var name = (menuItemsDict != null && menuItemsDict.TryGetValue(menuItemId, out var m2) ? m2.Name : menuItemId);
                                                var subtotal = menuPrice * qty;
                                                <li class="reservation-menu-item">
                                                    <div class="menu-item-row">
                                                        <span class="menu-name">@name</span>
                                                        <span class="menu-price">@menuPrice.ToString("C")</span>
                                                        <div class="qty-stepper">
                                                            <button class="stepper-btn" @onclick="() => ChangeMenuQuantity(reservation, menuItemId, -1)" disabled="@(isLoading)">-</button>
                                                            <span class="qty">@qty</span>
                                                            <button class="stepper-btn" @onclick="() => ChangeMenuQuantity(reservation, menuItemId, 1)" disabled="@(isLoading)">+</button>
                                                        </div>
                                                        <span class="menu-subtotal">@subtotal.ToString("C")</span>
                                                    </div>
                                                </li>
                                            }
                                        </ul>
                                    </div>
                                }
                            </div>

                            <div class="reservation-actions">
                                <button class="add-menu-button" @onclick="() => NavigateToMenu(reservation.Id)">Add menu items</button>
                                @if (reservation.Status == ReservationStatus.Confirmed && reservation.ReservationDate >= DateTime.Today)
                                {
                                    <button class="cancel-button" @onclick="() => CancelReservation(reservation.Id)">
                                        Cancel Reservation
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Order totals -->
        <div class="reservation-totals">
            <h3>Order summary</h3>
            @if (userReservations.Count > 0)
            {
                decimal grandTotal = 0m;
                foreach (var r in userReservations)
                {
                    decimal total = 0m;
                    if (r.MenuItems != null)
                    {
                        foreach (var mi in r.MenuItems)
                        {
                            if (menuItemsDict != null && menuItemsDict.TryGetValue(mi.Key, out var m))
                                total += m.Price * mi.Value;
                        }
                    }
                    grandTotal += total;
                    <div class="reservation-total-item">
                        <div>Reservation Table @r.TableNumber - @r.ReservationDate.ToString("MMMM dd, yyyy")</div>
                        <div>Total menu: @total.ToString("C")</div>
                    </div>
                }
                <div class="reservation-grand-total">
                    <strong>Grand total for all reservations: @grandTotal.ToString("C")</strong>
                </div>
            }
            else
            {
                <p>No reservations</p>
            }
        </div>
    </div>
}
@code {
    private string userName = "";
    private string userId = "";
    private DateTime selectedDate = DateTime.Today;
    private int numberOfGuests = 2;
    private int selectedTable = 0;
    private TimeSpan selectedStartTime = TimeSpan.Zero;
    private TimeSpan selectedEndTime = TimeSpan.Zero;
    private string specialRequests = "";
    private bool isLoading = false;
    private bool showSuccess = false;
    private string errorMessage = "";

    private List<Table> tables = new();
    private List<Reservation> userReservations = new();
    private System.Collections.Generic.Dictionary<string, MenuItem>? menuItemsDict;

    private class TimeSlot
    {
        public TimeSpan Start { get; set; }
        public TimeSpan End { get; set; }
        public string Display => $"{Start:hh\\:mm} - {End:hh\\:mm}";
    }

    private readonly List<TimeSlot> timeSlots = new()
    {
        new TimeSlot { Start = TimeSpan.FromHours(16), End = TimeSpan.FromHours(18) },
        new TimeSlot { Start = TimeSpan.FromHours(18), End = TimeSpan.FromHours(20) },
        new TimeSlot { Start = TimeSpan.FromHours(20), End = TimeSpan.FromHours(22) },
        new TimeSlot { Start = TimeSpan.FromHours(22), End = TimeSpan.FromHours(24) }
    };

    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    protected override async Task OnInitializedAsync()
    {
        if (!FirebaseAuthService.IsAuthenticated)
            return;

        userId = FirebaseAuthService.CurrentUserId;

        if (string.IsNullOrWhiteSpace(userId))
        {
            errorMessage = "Authenticated user ID is missing.";
            return;
        }

        await LoadUserData();
        await LoadUserReservations();
        tables = await ReservationService.GetTables();
        // preload menu items dictionary for display names
        var allMenu = await MenuService.GetMenu();
        menuItemsDict = allMenu?.ToDictionary(x => x.Id) ?? new System.Collections.Generic.Dictionary<string, MenuItem>();
    }

    private async Task LoadUserData()
    {
        try
        {
            var userProfile = await FirebaseAuthService.GetUserProfile(userId);

            if (userProfile != null && userProfile.Count > 0)
            {
                if (userProfile.ContainsKey("UserName"))
                    userName = userProfile["UserName"]?.ToString() ?? "User";
                else
                    userName = "User";
            }
            else
            {
                userName = "User";
                Debug.WriteLine("No user profile found in database for UID: " + userId);
            }
        }
        catch (Exception ex)
        {
            Debug.WriteLine($"Error loading user data: {ex.Message}");
            userName = "User";
        }
    }

    private async Task LoadUserReservations()
    {
        userReservations = await ReservationService.GetUserReservations(userId);
        StateHasChanged();
    }

    private void SelectTable(int tableNumber)
    {
        selectedTable = tableNumber;
        selectedStartTime = TimeSpan.Zero;
        selectedEndTime = TimeSpan.Zero;
    }

    private void SelectTimeSlot(TimeSpan start, TimeSpan end)
    {
        selectedStartTime = start;
        selectedEndTime = end;
    }

    private void NavigateToMenu(string reservationId)
    {
        var uri = $"/menu?reservationId={reservationId}";
        Navigation.NavigateTo(uri);
    }

    private async Task ChangeMenuQuantity(Reservation reservation, string menuItemId, int delta)
    {
        try
        {
            isLoading = true;
            StateHasChanged();

            if (reservation.MenuItems == null)
                reservation.MenuItems = new System.Collections.Generic.Dictionary<string,int>();

            var current = reservation.MenuItems.ContainsKey(menuItemId) ? reservation.MenuItems[menuItemId] : 0;
            var updatedQty = current + delta;

            if (updatedQty <= 0)
            {
                // confirm before removing
                var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Set quantity to 0 and remove item from reservation?");
                if (!confirmed)
                {
                    isLoading = false;
                    StateHasChanged();
                    return;
                }
                reservation.MenuItems.Remove(menuItemId);
            }
            else
            {
                reservation.MenuItems[menuItemId] = updatedQty;
            }

            var updated = await ReservationService.UpdateReservation(reservation);
            if (updated != null)
            {
                await LoadUserReservations();
            }
            else
            {
                errorMessage = "Could not update menu item quantity.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Error updating menu items: " + ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private bool IsTableAvailable(Table table)
    {
        return true; // For demo purposes, you can implement actual availability check
    }

    private List<TimeSlot> GetAvailableTimeSlots(int tableNumber)
    {
        return timeSlots; // For demo purposes, return all slots
    }

    private async Task ConfirmReservation()
    {
        try
        {
            isLoading = true;
            errorMessage = "";
            showSuccess = false;
            StateHasChanged();

            userId = FirebaseAuthService.CurrentUserId;

            if (string.IsNullOrWhiteSpace(userId))
                throw new Exception("No authenticated user found.");

            var reservation = new Reservation
            {
                UserId = userId,
                UserName = userName,
                TableNumber = selectedTable,
                ReservationDate = selectedDate.Date,
                StartTime = selectedStartTime,
                EndTime = selectedEndTime,
                NumberOfGuests = numberOfGuests,
                SpecialRequests = specialRequests ?? string.Empty,
                Status = ReservationStatus.Confirmed,
                CreatedAt = DateTime.UtcNow
            };

            var result = await ReservationService.CreateReservation(reservation);

            if (result != null)
            {
                showSuccess = true;
                await LoadUserReservations();

                selectedTable = 0;
                selectedStartTime = TimeSpan.Zero;
                selectedEndTime = TimeSpan.Zero;
                specialRequests = "";

                await Task.Delay(3000);
                showSuccess = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task CancelReservation(string reservationId)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this reservation?");

            if (confirmed)
            {
                isLoading = true;
                errorMessage = "";
                StateHasChanged();

                var success = await ReservationService.CancelReservation(reservationId, userId);

                if (success)
                    await LoadUserReservations();
                else
                    errorMessage = "Could not cancel reservation.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cancelling reservation: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
}
