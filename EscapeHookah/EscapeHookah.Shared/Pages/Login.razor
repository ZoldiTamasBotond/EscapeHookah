@page "/login"
@using EscapeHookah.Shared.Services
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject IFirebaseAuthService FirebaseAuthService

<PageTitle>EscapeHookah - Login</PageTitle>

<link rel="stylesheet" href="app.css" />

<div class="login-container">
    <div class="back-to-login">
        <a href="/" class="back-link">
            <span>←</span> Back to Home
        </a>
    </div>

    <div class="login-card">
        <div class="login-header">
            <div class="login-icon">🌿</div>
            <h1>Welcome Back</h1>
            <p>Sign in to continue to EscapeHookah</p>
        </div>

        @if (isLoading)
        {
            <div class="loading-overlay">
                <div class="spinner"></div>
                <p>Signing in...</p>
            </div>
        }

        <div class="login-form">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    ⚠️ @errorMessage
                </div>
            }

            <div class="form-group">
                <label class="form-label" for="email">Email</label>
                <div class="input-wrapper">
                    <span class="input-icon">📧</span>
                    <input type="email"
                           id="email"
                           class="form-input"
                           placeholder="Enter your email"
                           @bind="email"
                           @bind:event="oninput"
                           disabled="@isLoading" />
                </div>
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <div class="password-wrapper">
                    <span class="input-icon">🔒</span>
                    <input type="@(showPassword ? "text" : "password")"
                           id="password"
                           class="form-input"
                           placeholder="Enter your password"
                           @bind="password"
                           @bind:event="oninput"
                           disabled="@isLoading" />
                    <button type="button"
                            class="toggle-password"
                            @onclick="TogglePasswordVisibility"
                            disabled="@isLoading">
                        @(showPassword ? "👁️" : "👁️‍🗨️")
                    </button>
                </div>
            </div>

            <div class="form-options">
                <label class="remember-me">
                    <input type="checkbox" @bind="rememberMe" disabled="@isLoading" />
                    <span class="checkbox-custom"></span>
                    <span class="remember-text">Remember me</span>
                </label>
                <a href="#" class="forgot-link">Forgot Password?</a>
            </div>

            <button class="login-button" @onclick="HandleLogin" disabled="@isLoading">
                @(isLoading ? "Signing In..." : "Sign In")
            </button>

            <div class="signup-section">
                <span class="signup-text">Don't have an account?</span>
                <a href="/register" class="signup-link">Sign Up</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private bool rememberMe = false;
    private bool showPassword = false;
    private bool isLoading = false;
    private string errorMessage = "";

    private void TogglePasswordVisibility() => showPassword = !showPassword;



    private async Task HandleLogin()
    {
        // Clear previous errors
        errorMessage = "";

        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Email and password are required";
            return;
        }

        try
        {
            isLoading = true;
            StateHasChanged();

            var success = await FirebaseAuthService.LoginUser(email, password);

            if (success)
            {
                // Note: The token is automatically set inside LoginUser method
                await JSRuntime.InvokeVoidAsync("alert", $"Welcome back! You're now signed in.");
                Navigation.NavigateTo("/");
            }
            else
            {
                errorMessage = "Invalid email or password";
                isLoading = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Login error: {ex.Message}";
            isLoading = false;
        }
    }


}