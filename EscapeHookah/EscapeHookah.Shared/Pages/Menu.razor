@page "/menu"
@using EscapeHookah.Shared.Services
@using EscapeHookah.Shared.Models
@using System.Collections.Generic
@inject IMenuService MenuService
@inject IReservationService ReservationService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>EscapeHookah - Menu</PageTitle>

<div class="menu-container">
    <h1>Menu</h1>

    @if (!string.IsNullOrWhiteSpace(reservationId))
    {
        <div class="reservation-context">
            @if (currentReservation != null)
            {
                <div class="current-reservation-summary">
                    <p>Reservation for Table: @currentReservation.TableNumber — @currentReservation.ReservationDate.ToString("MMMM dd, yyyy") @currentReservation.StartTime.ToString(@"hh\:mm")</p>
                    @if (currentReservation.MenuItems != null && currentReservation.MenuItems.Count > 0)
                    {
                        <p>Current menu items:</p>
                        <ul>
                            @foreach (var mi in currentReservation.MenuItems)
                            {
                                <li>@(menuItems?.FirstOrDefault(x => x.Id == mi.Key)?.Name ?? mi.Key) x @mi.Value</li>
                            }
                        </ul>
                    }
                </div>
            }
            else
            {
                <p>Adding to reservation...</p>
            }
        </div>
    }

    <div class="menu-list">
        @if (menuItems == null)
        {
            <p>Loading...</p>
        }
        else
        {
            @foreach (var item in menuItems)
            {
                <div class="menu-item">
                    <div class="menu-info">
                        <h3>@item.Name <span class="price">@item.Price.ToString("C")</span></h3>
                        <p class="desc">@item.Description</p>
                    </div>
                    <div class="menu-actions">
                        @if (!string.IsNullOrWhiteSpace(reservationId))
                        {
                            <button @onclick="() => AddToReservationAsync(item.Id)" disabled="@(isProcessing && currentAddId == item.Id)">
                                @(isProcessing && currentAddId == item.Id ? "Adding..." : "Add to Reservation")
                            </button>
                        }
                    </div>
                </div>
            }
        }
    </div>
</div>

@code {
    private List<MenuItem>? menuItems;
    private string? reservationId;
    private Reservation? currentReservation;
    private bool isProcessing = false;
    private string? currentAddId;

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (!string.IsNullOrWhiteSpace(q.Get("reservationId")))
            reservationId = q.Get("reservationId");

        menuItems = await MenuService.GetMenu();

        if (!string.IsNullOrWhiteSpace(reservationId))
        {
            currentReservation = await ReservationService.GetReservationById(reservationId!);
        }
    }

    private async Task AddToReservationAsync(string itemId)
    {
        if (string.IsNullOrWhiteSpace(reservationId))
        {
            // no reservation context, redirect to /reservations with addItem param so user can choose/confirm a reservation
            var uri = $"/reservations?addItem={itemId}";
            Navigation.NavigateTo(uri);
            return;
        }

        try
        {
            isProcessing = true;
            currentAddId = itemId;
            StateHasChanged();

            var ok = await ReservationService.AddMenuItemsToReservation(reservationId!, new System.Collections.Generic.List<MenuSelection> { new MenuSelection { MenuItemId = itemId, Quantity = 1 } });
            if (ok)
            {
                // refresh local reservation so UI shows the added item and allow adding more without leaving
                currentReservation = await ReservationService.GetReservationById(reservationId!);
                await JSRuntime.InvokeVoidAsync("alert", "Menu item added to reservation. You can add more items.");
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", "Could not add menu item to reservation.");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Error adding menu item: " + ex.Message);
        }
        finally
        {
            isProcessing = false;
            currentAddId = null;
            StateHasChanged();
        }
    }
}
